# Shopify API Configuration
# Copy this file to .env and fill in your actual values

# Your Shopify store URL (required)
# Example: https://your-store.myshopify.com
SHOPIFY_STORE=https://your-store.myshopify.com

# Authentication: Use EITHER access token OR client credentials
#
# Option A: Direct access token (long-lived, from Shopify Admin)
# Get this from: Shopify Admin -> Settings -> Apps and sales channels -> Develop apps -> Configure Admin API scopes
# Requires these scopes: read_products, write_products, read_customers, write_customers, read_orders, write_orders, read_content, write_content, read_collection_listings, write_collection_listings, read_metaobjects, write_metaobjects
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option B: Client credentials (recommended — short-lived tokens auto-refresh)
# Get these from: Shopify Partners Dashboard -> Apps -> [Your App] -> Settings
# Tokens expire after 24 hours and are automatically refreshed by both the
# backup and restore tools. Backup performs proactive scope validation at
# startup and aborts if any required scope is missing.
# SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SHOPIFY_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override credentials cache file path (default: ~/.config/goshopify/credentials.json)
# Useful for systemd service installs that should not use ~/.config.
# GOSHOPIFY_CREDS_FILE=/etc/goshopify/credentials.json

# Shopify API version (optional, default: 2025-07 for restore, 2025-01 for backup)
# Format: YYYY-MM
SHOPIFY_API_VERSION=2025-07

# Backup directory (required for restore)
# Directory containing JSON backup files organized by date: BACKUP_DIR/YYYY-MM-DD/
BACKUP_DIR=./backups

# Log directory (optional, default: /var/log/goshopify)
# Directory for restore operation logs
LOG_DIR=./logs

# Rollback directory (optional, default: /var/log/goshopify)
# Directory for rollback scripts generated after restore operations
ROLLBACK_DIR=./rollbacks